# Copy this file to .env (same folder) and paste your key after the = sign.
# .env is git-ignored: never share it or commit it.
#
# Free TomTom key, no credit card:
#   1. https://my.tomtom.com  ->  Register (email + password)
#   2. https://my.tomtom.com/keys  ->  click "My first API key" (made for you) and copy it
#      (if the page shows product checkboxes, keep Routing API, Search API, Traffic API ticked)
#   3. Paste it after the = sign below, no quotes. A new key can take a few minutes to go live.
#
# Free monthly allowance (as of Oct 2026): Routing 20K, Geocoding 20K,
# Traffic Incident Details 2.5K. One route check = 1 routing call + 1 incidents call
# (the two addresses are geocoded once and cached), so ~80 checks a day stays free.
TOMTOM_API_KEY=

# The two ends of the trip. The address is what TomTom looks up; the label is what the reports,
# map and buttons show (optional: "Hospital" / "Home" if left out). Quotes are fine. If you change
# an address, delete cache\geocode.json so it is looked up again.
# On Streamlit Cloud the same names go in the app's Secrets box (README.md shows the block).
HOSPITAL_LABEL="Hospital name, Town"
HOSPITAL_ADDRESS="123 Example St, Town, NJ 00000"
HOME_LABEL="Home"
HOME_ADDRESS="456 Example Ave, Town, NJ 00000"
